# Токен вашего бота, выданный @BotFather (команда /newbot)
BOT_TOKEN=123456789:AA...ваш_токен...

# Ваш личный chat_id в Telegram — сюда бот будет слать уведомления о заказах.
# Как узнать: напишите боту @userinfobot, он пришлёт ваш id.
ADMIN_CHAT_ID=123456789

# Пароль для входа в админ-панель (/admin) — придумайте свой
ADMIN_PASSWORD=change-me-please

# Порт (Railway/Render подставят свой автоматически, локально можно оставить 3000)
PORT=3000
